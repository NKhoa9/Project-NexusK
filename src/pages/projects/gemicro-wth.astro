---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="GeMicro-wth" description="A local-first chat workspace with GeMicro (Gehihi)." fullWidth>
    <div class="chat-app">
        <aside class="chat-sidebar" id="chat-sidebar">
            <div class="sidebar-top">
                <a href="/projects" class="back-link" title="Back to Projects">
                    ←
                </a>
                <span class="brand">GeMicro-wth</span>
                <button id="sidebar-toggle" class="icon-button mobile-only" aria-label="Close sidebar">
                    ×
                </button>
            </div>
            <button id="new-chat" class="new-chat">
                <span>＋</span> New chat
            </button>
            <div class="side-label">Your chats</div>
            <nav id="chat-list" class="chat-list" aria-label="Saved chats"></nav>
            <div class="sidebar-bottom">
                <button id="settings-open" type="button" class="memory-button" onclick="document.getElementById('settings-dialog').hidden = false">
                    <span>⚙</span>
                    <span>
                        <b>Gemini settings</b>
                        <small>Key, model & personalization</small>
                    </span>
                </button>
                <button id="memory-open" class="memory-button">
                    <span>✦</span>
                    <span>
                        <b>Memories</b>
                        <small id="memory-count">Saved on this device</small>
                    </span>
                </button>
                <p>Gemini models only · Data stays in this browser.</p>
            </div>
        </aside>

        <main class="chat-main">
            <header class="chat-topbar">
                <button id="mobile-menu" class="icon-button mobile-only" aria-label="Open sidebar">
                    ☰
                </button>
                <span id="active-title" class="active-title">
                    New chat
                </span>
                <div class="chat-actions-wrap">
                    <button id="chat-actions" class="icon-button" aria-label="Chat options" title="Chat options" aria-expanded="false">
                        ···
                    </button>
                    <div id="active-chat-menu" class="chat-menu" hidden></div>
                </div>
            </header>
            <div id="message-scroll" class="message-scroll">
                <div id="welcome" class="welcome">
                    <div class="welcome-mark">✳</div>
                    <h1>What shall we work on?</h1>
                    <p>Ask a question, explore an idea, or work through some math.</p>
                    <div class="suggestions">
                        <button data-prompt="Explain why the derivative of x² is 2x, using the limit definition.">Explain a math idea</button>
                        <button data-prompt="Help me solve this step by step: \\(x^2 - 5x + 6 = 0\\)">Solve an equation</button>
                        <button data-prompt="Help me organize my thoughts about a project.">Explore an idea</button>
                    </div>
                </div>
                <div id="messages" class="messages" aria-live="polite"></div>
            </div>
            <div class="composer-area">
                <form id="composer" class="composer">
                    <button type="button" id="attach" class="tool-button attach-button" title="Attach files" aria-label="Attach files">
                        ＋
                    </button>
                    <textarea id="prompt" rows="1" placeholder="Message GeMicro-wth" aria-label="Message GeMicro-wth"></textarea>
                    <input id="file-input" type="file" accept="image/*,application/pdf,text/*,application/json,.js,.jsx,.ts,.tsx,.py,.java,.c,.cpp,.h,.cs,.go,.rs,.html,.css,.md,.csv,.xml,.yaml,.yml,.toml,.sh" multiple hidden />
                    <div id="attachment-list" class="attachment-list" aria-live="polite"></div>
                    <div class="composer-tools">
                        <div class="effort-picker">
                            <button type="button" id="effort-menu-toggle" aria-expanded="false">
                                <span>
                                    Thinking · <b id="effort-label">Auto</b>
                                </span>
                                <svg class="model-chevron" viewBox="0 0 20 20" aria-hidden="true">
                                    <path d="m5 7.5 5 5 5-5" />
                                </svg>
                            </button>
                            <div id="effort-menu" class="model-menu effort-menu" hidden></div>
                        </div>
                        <div class="model-picker">
                            <button type="button" id="model-menu-toggle" aria-expanded="false">
                                Gemini · <span id="model-label">2.5 Flash</span>
                                <svg class="model-chevron" viewBox="0 0 20 20" aria-hidden="true">
                                    <path d="m5 7.5 5 5 5-5" />
                                </svg>
                            </button>
                            <div id="model-menu" class="model-menu" hidden></div>
                        </div>
                        <button type="submit" id="send" class="send-button" aria-label="Send message">
                            ↑
                        </button>
                    </div>
                </form>
                <p class="disclaimer">Gemini models only · Messages are sent directly to Google with your API key.</p>
            </div>
        </main>

        <dialog id="memory-dialog" class="memory-dialog">
            <form method="dialog" class="dialog-head">
                <div>
                    <h2>Memories</h2>
                    <p>Notes GeMicro-wth can keep on this device.</p>
                </div>
                <button class="icon-button" aria-label="Close">
                    ×
                </button>
            </form>
            <div id="memory-list" class="memory-list"></div>
            <form id="memory-form" class="memory-form">
                <textarea name="memory" rows="3" placeholder="Add a memory…" required></textarea>
                <button class="send-button" aria-label="Save memory">
                    ↑
                </button>
            </form>
            <p class="privacy-note">Stored in this browser’s local storage. Clearing site data removes these memories.</p>
        </dialog>
        <div id="settings-dialog" class="settings-overlay" hidden role="dialog" aria-modal="true" aria-labelledby="settings-title">
            <section class="memory-dialog settings-dialog">
                <div class="dialog-head">
                    <div>
                        <h2 id="settings-title">Gemini settings</h2>
                        <p>GeMicro-wth uses Google Gemini models only.</p>
                    </div>
                    <button
                        type="button"
                        id="settings-close"
                        class="icon-button"
                        aria-label="Close"
                        onclick="document.getElementById('settings-dialog').hidden = true"
                    >
                        ×
                    </button>
                </div>
                <form id="settings-form" class="settings-form">
                    <div>
                        <div class="key-title">
                            Google AI Studio API keys{' '}
                            <a href="https://aistudio.google.com/app/apikey" target="_blank" rel="noreferrer">
                                Get a key ↗
                            </a>
                        </div>
                        <div id="api-key-list"></div>
                        <div class="key-add-row">
                            <input id="new-api-key" type="password" autocomplete="off" placeholder="Paste an API key" />
                            <button type="button" id="add-api-key" class="settings-secondary">
                                Add key
                            </button>
                        </div>
                    </div>
                    <p class="privacy-note">
                        Keys are tried in order if a request fails. They’re stored in this browser’s local storage and sent directly to Google. Anyone with
                        access to this browser profile can inspect them.
                    </p>
                    <div class="model-settings-head">
                        <b>Models</b>
                        <button type="button" id="refresh-models" class="settings-secondary">
                            Fetch from Google
                        </button>
                    </div>
                    <p class="privacy-note">Turn models on or off for the chat model menu. Fetch requires a saved API key.</p>
                    <div id="model-settings-list" class="model-settings-list"></div>
                    <label class="accent-control">
                        Accent color
                        <input id="accent-color" type="color" value="#8b74dc" />
                    </label>
                    <label>
                        About you<textarea name="about" rows="3" placeholder="What should Gemini know about you? Preferences, background, goals…"></textarea>
                    </label>
                    <label>
                        Assistant instructions<textarea name="instructions" rows="6"></textarea>
                    </label>
                    <div class="settings-actions">
                        <button type="button" id="test-key" class="settings-secondary">
                            Test key
                        </button>
                        <button type="submit" class="settings-primary">
                            Save settings
                        </button>
                    </div>
                    <p id="settings-status" class="settings-status" role="status"></p>
                </form>
            </section>
        </div>
        <div id="toast" class="toast" role="status"></div>
    </div>
</Layout>

<script>
    import { marked } from 'marked';
    type Message = { role: 'user' | 'assistant'; content: string; time: number };
    type GeminiPart = { text?: string; inline_data?: { mime_type: string; data: string } };
    type Chat = { id: string; title: string; updated: number; messages: Message[]; pinned?: boolean };
    type Model = { name: string; displayName: string; description?: string; supportedGenerationMethods?: string[] };
    type Settings = {
        apiKeys: string[];
        model: string;
        about: string;
        instructions: string;
        enabledModels?: string[];
        accent?: string;
        thinkingEffort?: string;
    };
    const CHAT_KEY = 'gemicro-wth.chats.v1',
        MEMORY_KEY = 'gemicro-wth.memories.v1',
        SETTINGS_KEY = 'gemicro-wth.settings.v1',
        MODELS_KEY = 'gemicro-wth.models.v1';
    const DEFAULT_INSTRUCTIONS = `You are GeMicro-wth, a helpful, clear, thoughtful assistant powered exclusively by Google Gemini models. Adapt to the user's needs, explain reasoning clearly, and be honest about uncertainty. For mathematics, preserve and use correct notation, show steps when useful, distinguish assumptions from results, and format inline math with \\(…\\) and display math with \\[ … \\]. Use Markdown for readable structure and fenced code blocks for code. Keep answers focused and ask a concise clarifying question when a request is ambiguous.`;
    const read = <T,>(key: string, fallback: T): T => {
        try {
            const value = localStorage.getItem(key);
            return value ? (JSON.parse(value) as T) : fallback;
        } catch {
            return fallback;
        }
    };
    const storedSettings = read<Settings & { apiKey?: string }>(SETTINGS_KEY, {
        apiKeys: [],
        model: 'gemini-2.5-flash',
        about: '',
        instructions: DEFAULT_INSTRUCTIONS
    });
    let chats = read<Chat[]>(CHAT_KEY, []),
        memories = read<string[]>(MEMORY_KEY, []),
        settings: Settings = { ...storedSettings, apiKeys: storedSettings.apiKeys ?? (storedSettings.apiKey ? [storedSettings.apiKey] : []) },
        activeId: string | null = null;
    let availableModels = read<Model[]>(MODELS_KEY, []);
    let pendingFiles: File[] = [];
    const $ = <T extends HTMLElement = HTMLElement>(selector: string): T => document.querySelector<T>(selector)!;
    const escape = (value: string) => value.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
    const persist = () => {
        localStorage.setItem(CHAT_KEY, JSON.stringify(chats));
        localStorage.setItem(MEMORY_KEY, JSON.stringify(memories));
        localStorage.setItem(SETTINGS_KEY, JSON.stringify(settings));
    };
    const toast = (text: string) => {
        const node = $('#toast');
        node.textContent = text;
        node.classList.add('show');
        setTimeout(() => node.classList.remove('show'), 2400);
    };
    const current = () => chats.find((chat) => chat.id === activeId) ?? null;
    const md = (text: string) => {
        const mathExpressions: string[] = [];
        const protectedText = text.replace(/\\\[[\s\S]*?\\\]|\\\([\s\S]*?\\\)|\$\$[\s\S]*?\$\$|(?<!\$)\$(?!\$)[^\n$]+\$(?!\$)/g, (expression) => {
            const marker = `GEMATHPLACEHOLDER${mathExpressions.length}END`;
            mathExpressions.push(expression);
            return marker;
        });
        let html = marked.parse(protectedText, { async: false }) as string;
        mathExpressions.forEach((expression, index) => { html = html.replace(`GEMATHPLACEHOLDER${index}END`, expression); });
        return html;
    };
    const defaultModels: Model[] = ['gemini-2.5-flash', 'gemini-2.5-pro', 'gemini-2.0-flash'].map((name) => ({
        name,
        displayName: name.replace('gemini-', '').replaceAll('-', ' ')
    }));
    const modelName = (name: string) => name.replace(/^models\//, '');
    function enabledModels() {
        return (availableModels.length ? availableModels : defaultModels).filter(
            (model) => !settings.enabledModels || settings.enabledModels.includes(modelName(model.name))
        );
    }
    function renderModelMenu() {
        const models = enabledModels(),
            menu = $('#model-menu');
        if (!models.some((model) => modelName(model.name) === settings.model) && models.length) settings.model = modelName(models[0].name);
        $('#model-label').textContent = settings.model.replace(/^gemini-/, '').replaceAll('-', ' ');
        menu.innerHTML =
            models
                .map(
                    (model) =>
                        `<button type="button" data-select-model="${escape(modelName(model.name))}" class="model-option ${modelName(model.name) === settings.model ? 'active' : ''}">${escape(model.displayName || modelName(model.name))}</button>`
                )
                .join('') || '<p class="model-empty">No enabled Gemini models. Turn one on in settings.</p>';
        menu.querySelectorAll<HTMLButtonElement>('[data-select-model]').forEach((button) =>
            button.addEventListener('click', () => {
                settings.model = button.dataset.selectModel!;
                persist();
                renderModelMenu();
                menu.hidden = true;
                $('#model-menu-toggle').setAttribute('aria-expanded', 'false');
            })
        );
    }
    function renderModelSettings() {
        const models = availableModels.length ? availableModels : defaultModels;
        $('#model-settings-list').innerHTML = models
            .map((model) => {
                const name = modelName(model.name),
                    enabled = !settings.enabledModels || settings.enabledModels.includes(name);
                return `<label class="model-setting"><span class="model-setting-info"><b>${escape(model.displayName || name)}</b><small>${escape(name)}</small></span><input class="model-switch-input" type="checkbox" role="switch" data-toggle-model="${escape(name)}" ${enabled ? 'checked' : ''} /><span class="model-switch" aria-hidden="true"></span></label>`;
            })
            .join('');
        $('#model-settings-list')
            .querySelectorAll<HTMLInputElement>('[data-toggle-model]')
            .forEach((input) =>
                input.addEventListener('change', () => {
                    const name = input.dataset.toggleModel!;
                    const enabled = new Set(settings.enabledModels ?? models.map((model) => modelName(model.name)));
                    input.checked ? enabled.add(name) : enabled.delete(name);
                    settings.enabledModels = [...enabled];
                    persist();
                    renderModelMenu();
                })
            );
    }

    function renderSidebar() {
        const list = $('#chat-list');
        list.innerHTML =
            chats
                .slice()
                .sort((a, b) => Number(b.pinned) - Number(a.pinned) || b.updated - a.updated)
                .map(
                    (chat) =>
                        `<div class="chat-item ${chat.id === activeId ? 'selected' : ''}"><button data-chat="${chat.id}" class="chat-name" title="${escape(chat.title)}">${chat.pinned ? '📌 ' : ''}${escape(chat.title)}</button><button data-chat-menu="${chat.id}" class="chat-delete" aria-label="Options for ${escape(chat.title)}" title="Chat options">···</button></div>`
                )
                .join('') || '<p class="empty-chats">Your conversations will appear here.</p>';
        list.querySelectorAll<HTMLButtonElement>('[data-chat]').forEach((button) => button.addEventListener('click', () => openChat(button.dataset.chat!)));
        list.querySelectorAll<HTMLButtonElement>('[data-chat-menu]').forEach((button) =>
            button.addEventListener('click', (event) => {
                event.stopPropagation();
                const menu = $('#active-chat-menu');
                if (!menu.hidden && menu.dataset.chatId === button.dataset.chatMenu) {
                    menu.hidden = true;
                    $('#chat-actions').setAttribute('aria-expanded', 'false');
                    return;
                }
                showChatMenu(button.dataset.chatMenu!, button);
            })
        );
        $('#memory-count').textContent = `${memories.length} saved ${memories.length === 1 ? 'memory' : 'memories'}`;
    }
    function renderMessages() {
        const chat = current(),
            messages = $('#messages'),
            welcome = $('#welcome');
        $('#active-title').textContent = chat?.title ?? 'New chat';
        welcome.hidden = !!chat?.messages.length;
        const mathJax = window as Window & { MathJax?: { typesetClear?: (elements?: HTMLElement[]) => void } };
        mathJax.MathJax?.typesetClear?.([messages]);
        messages.innerHTML = (chat?.messages ?? [])
            .map(
                (message) =>
                    `<article class="message ${message.role}"><div class="message-avatar">${message.role === 'user' ? 'You' : '✳'}</div><div class="message-content">${md(message.content)}</div></article>`
            )
            .join('');
        messages.querySelectorAll<HTMLPreElement>('.message-content pre').forEach((block) => {
            if (block.querySelector('.code-toolbar')) return;
            const code = block.querySelector('code');
            const language = [...(code?.classList ?? [])].find((name) => name.startsWith('language-'))?.slice(9) || 'Code';
            const toolbar = document.createElement('div');
            toolbar.className = 'code-toolbar';
            const label = document.createElement('span');
            label.textContent = language;
            const copy = document.createElement('button');
            copy.type = 'button';
            copy.className = 'code-copy';
            copy.textContent = 'Copy code';
            copy.setAttribute('aria-label', 'Copy code block');
            copy.addEventListener('click', async () => {
                try {
                    await navigator.clipboard.writeText(code?.textContent ?? block.textContent ?? '');
                    copy.textContent = 'Copied';
                    window.setTimeout(() => { copy.textContent = 'Copy code'; }, 1500);
                } catch {
                    toast('Could not copy code. Check clipboard permissions.');
                }
            });
            toolbar.append(label, copy);
            block.prepend(toolbar);
        });
        typeset();
        $('#message-scroll').scrollTop = $('#message-scroll').scrollHeight;
        renderSidebar();
    }
    function typeset() {
        const math = window as Window & { MathJax?: { typesetPromise?: (elements?: HTMLElement[]) => Promise<void>; startup?: { promise?: Promise<unknown> } } };
        if (!math.MathJax?.typesetPromise) return;
        const render = () => math.MathJax?.typesetPromise?.([$('#messages')]).catch(() => {});
        if (math.MathJax.startup?.promise) void math.MathJax.startup.promise.then(render).catch(() => {});
        else void render();
    }
    function openChat(id: string) {
        activeId = id;
        renderMessages();
        $('#chat-sidebar').classList.remove('open');
    }
    function newChat() {
        activeId = null;
        renderMessages();
        $('#prompt').focus();
    }
    function deleteChat(id: string) {
        chats = chats.filter((chat) => chat.id !== id);
        if (activeId === id) activeId = null;
        persist();
        renderMessages();
        toast('Chat deleted');
    }
    function showChatMenu(id: string, anchor: HTMLElement) {
        const menu = $('#active-chat-menu');
        document.body.append(menu);
        const chat = chats.find((item) => item.id === id);
        if (!chat) return;
        menu.dataset.chatId = id;
        menu.innerHTML = `<button data-action="rename">Rename</button><button data-action="pin">${chat.pinned ? 'Unpin' : 'Pin'}</button><button data-action="delete" class="danger">Delete</button>`;
        const rect = anchor.getBoundingClientRect();
        menu.style.position = 'fixed';
        menu.style.left = `${Math.max(8, Math.min(rect.right - 150, innerWidth - 158))}px`;
        menu.style.top = `${Math.min(rect.bottom + 6, innerHeight - 130)}px`;
        menu.hidden = false;
        $('#chat-actions').setAttribute('aria-expanded', 'true');
    }
    function addMessage(role: Message['role'], content: string) {
        if (!activeId) {
            activeId = crypto.randomUUID();
            chats.unshift({ id: activeId, title: content.replace(/\s+/g, ' ').slice(0, 42) || 'New chat', updated: Date.now(), messages: [] });
        }
        const chat = current()!;
        chat.messages.push({ role, content, time: Date.now() });
        chat.updated = Date.now();
        persist();
        renderMessages();
    }
    function fileAsBase64(file: File): Promise<string> {
        return new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.onload = () => resolve(String(reader.result).split(',')[1] ?? '');
            reader.onerror = () => reject(new Error(`Could not read ${file.name}.`));
            reader.readAsDataURL(file);
        });
    }
    async function geminiReply(chat: Chat, files: File[] = []) {
        if (!settings.apiKeys.length)
            return 'Add a Google AI Studio API key in **Gemini settings** to start chatting. Your conversations remain saved locally.';
        const profile = [
            settings.about.trim() ? `About the user:\n${settings.about.trim()}` : '',
            memories.length ? `Saved user memories:\n${memories.map((m) => `- ${m}`).join('\n')}` : ''
        ]
            .filter(Boolean)
            .join('\n\n');
        const systemInstruction = [settings.instructions || DEFAULT_INSTRUCTIONS, profile].filter(Boolean).join('\n\n');
        const contents = chat.messages
            .filter((message) => message.content !== 'Thinking…')
            .map((message) => ({ role: message.role === 'assistant' ? 'model' : 'user', parts: [{ text: message.content }] as GeminiPart[] }));
        if (files.length && contents.length) {
            if (files.reduce((total, file) => total + file.size, 0) > 20 * 1024 * 1024) throw new Error('Attachments must total 20 MB or less per message.');
            const lastUser = [...contents].reverse().find((message) => message.role === 'user');
            if (lastUser) for (const file of files) {
                if (file.size > 20 * 1024 * 1024) throw new Error(`${file.name} is larger than the 20 MB attachment limit.`);
                const isImageOrPdf = file.type.startsWith('image/') || file.type === 'application/pdf';
                const textLike = file.type.startsWith('text/') || file.type === 'application/json' || /\.(js|jsx|ts|tsx|py|java|c|cpp|h|cs|go|rs|html|css|md|csv|xml|ya?ml|toml|sh)$/i.test(file.name);
                if (isImageOrPdf) {
                    lastUser.parts.push({ inline_data: { mime_type: file.type || 'application/octet-stream', data: await fileAsBase64(file) } });
                } else if (textLike) {
                    lastUser.parts.push({ text: `\n\n[Attached file: ${file.name}]\n${await file.text()}` });
                } else {
                    throw new Error(`${file.name} is not a supported attachment. Use an image, PDF, or text/code file.`);
                }
            }
        }
        const generationConfig: Record<string, unknown> = { temperature: 0.7 };
        if (settings.thinkingEffort && settings.thinkingEffort !== 'auto') {
            if (modelName(settings.model).startsWith('gemini-3')) generationConfig.thinkingConfig = { thinkingLevel: settings.thinkingEffort.toUpperCase() };
            else
                generationConfig.thinkingConfig = {
                    thinkingBudget: ({ low: 1024, medium: 8192, high: 24576 } as Record<string, number>)[settings.thinkingEffort]
                };
        }
        let lastError = 'Gemini returned an empty response.';
        for (let i = 0; i < settings.apiKeys.length; i++) {
            try {
                const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/${encodeURIComponent(settings.model)}:generateContent`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'x-goog-api-key': settings.apiKeys[i] },
                    body: JSON.stringify({ systemInstruction: { parts: [{ text: systemInstruction }] }, contents, generationConfig })
                });
                const result = await response.json();
                if (!response.ok) {
                    lastError = result.error?.message || `Gemini API error (${response.status})`;
                    continue;
                }
                const text = result.candidates?.[0]?.content?.parts?.map((part: { text?: string }) => part.text ?? '').join('');
                if (text) return text;
                lastError = result.promptFeedback?.blockReason
                    ? `Gemini blocked this request: ${result.promptFeedback.blockReason}`
                    : 'Gemini returned an empty response.';
            } catch (error) {
                lastError = error instanceof Error ? error.message : 'Network request failed.';
            }
        }
        throw new Error(`All ${settings.apiKeys.length} saved key${settings.apiKeys.length === 1 ? '' : 's'} failed. Last error: ${lastError}`);
    }
    async function requestReply(files: File[] = []) {
        const chat = current();
        if (!chat) return;
        const pending: Message = { role: 'assistant', content: 'Thinking…', time: Date.now() };
        chat.messages.push(pending);
        renderMessages();
        try {
            pending.content = await geminiReply(chat, files);
        } catch (error) {
            pending.content = `**Gemini request failed**\n\n${error instanceof Error ? error.message : 'Unknown error'}`;
        }
        chat.updated = Date.now();
        persist();
        renderMessages();
    }
    $('#composer').addEventListener('submit', (event) => {
        event.preventDefault();
        const prompt = ($('#prompt') as HTMLTextAreaElement).value.trim();
        if (!prompt && !pendingFiles.length) return;
        const files = [...pendingFiles];
        const attachmentNames = files.length ? `\n\n_Attached: ${files.map((file) => file.name).join(', ')}_` : '';
        addMessage('user', `${prompt || 'Please review the attached file(s).'}${attachmentNames}`);
        ($('#prompt') as HTMLTextAreaElement).value = '';
        pendingFiles = [];
        renderAttachmentList();
        void requestReply(files);
    });
    $('#prompt').addEventListener('keydown', (event) => {
        if (event.key === 'Enter' && !event.shiftKey) {
            event.preventDefault();
            ($('#composer') as HTMLFormElement).requestSubmit();
        }
        const area = event.currentTarget as HTMLTextAreaElement;
        requestAnimationFrame(() => {
            area.style.height = 'auto';
            area.style.height = `${Math.min(area.scrollHeight, 180)}px`;
        });
    });
    $('#new-chat').addEventListener('click', newChat);
    document.querySelectorAll<HTMLButtonElement>('[data-prompt]').forEach((button) =>
        button.addEventListener('click', () => {
            ($('#prompt') as HTMLTextAreaElement).value = button.dataset.prompt ?? '';
            ($('#composer') as HTMLFormElement).requestSubmit();
        })
    );
    $('#memory-open').addEventListener('click', () => {
        renderMemories();
        ($('#memory-dialog') as HTMLDialogElement).showModal();
    });
    function renderMemories() {
        $('#memory-list').innerHTML =
            memories
                .map(
                    (memory, index) =>
                        `<div class="memory-row"><span>${escape(memory)}</span><button data-memory-delete="${index}" class="icon-button" aria-label="Delete memory">×</button></div>`
                )
                .join('') || '<p class="empty-chats">No memories saved yet.</p>';
        $('#memory-list')
            .querySelectorAll<HTMLButtonElement>('[data-memory-delete]')
            .forEach((button) =>
                button.addEventListener('click', () => {
                    memories.splice(Number(button.dataset.memoryDelete), 1);
                    persist();
                    renderMemories();
                    renderSidebar();
                })
            );
    }
    $('#memory-form').addEventListener('submit', (event) => {
        event.preventDefault();
        const form = event.currentTarget as HTMLFormElement,
            input = form.elements.namedItem('memory') as HTMLTextAreaElement;
        const value = input.value.trim();
        if (!value) return;
        memories.push(value);
        input.value = '';
        persist();
        renderMemories();
        renderSidebar();
        toast('Memory saved on this device');
    });
    $('#settings-open').addEventListener('click', () => {
        renderApiKeys();
        renderModelSettings();
        ($('#accent-color') as HTMLInputElement).value = settings.accent || '#8b74dc';
        const form = $('#settings-form') as HTMLFormElement;
        (form.elements.namedItem('about') as HTMLTextAreaElement).value = settings.about;
        (form.elements.namedItem('instructions') as HTMLTextAreaElement).value = settings.instructions || DEFAULT_INSTRUCTIONS;
        $('#settings-status').textContent = '';
        const overlay = $('#settings-dialog');
        overlay.hidden = false;
        overlay.classList.add('is-open');
    });
    $('#settings-form').addEventListener('submit', (event) => {
        event.preventDefault();
        const form = event.currentTarget as HTMLFormElement;
        settings = {
            ...settings,
            apiKeys: settings.apiKeys ?? [],
            about: (form.elements.namedItem('about') as HTMLTextAreaElement).value.trim(),
            instructions: (form.elements.namedItem('instructions') as HTMLTextAreaElement).value.trim() || DEFAULT_INSTRUCTIONS,
            accent: ($('#accent-color') as HTMLInputElement).value
        };
        persist();
        closeSettings();
        toast('Gemini settings saved on this device');
    });
    $('#test-key').addEventListener('click', async () => {
        const key = settings.apiKeys[0];
        const model = ($('#chat-model') as HTMLSelectElement).value;
        const status = $('#settings-status');
        status.textContent = 'Testing Gemini API key…';
        if (!key) {
            status.textContent = 'Paste an API key first.';
            return;
        }
        try {
            const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/${encodeURIComponent(model)}:generateContent`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'x-goog-api-key': key },
                body: JSON.stringify({ contents: [{ role: 'user', parts: [{ text: 'Reply with OK.' }] }], generationConfig: { maxOutputTokens: 8 } })
            });
            const body = await response.json();
            status.textContent = response.ok ? `Connected to ${model}.` : body.error?.message || `Request failed (${response.status}).`;
        } catch {
            status.textContent = 'Could not connect. Check your network and try again.';
        }
    });
    function renderApiKeys() {
        settings.apiKeys ??= [];
        $('#api-key-list').innerHTML =
            settings.apiKeys
                .map(
                    (key, index) =>
                        `<div class="saved-key"><span>Key ${index + 1}</span><code>••••${escape(key.slice(-4))}</code><button type="button" data-key-remove="${index}" aria-label="Remove key ${index + 1}">×</button></div>`
                )
                .join('') || '<p class="privacy-note">No keys saved yet. Add one below to enable Gemini.</p>';
        $('#api-key-list')
            .querySelectorAll<HTMLButtonElement>('[data-key-remove]')
            .forEach((button) =>
                button.addEventListener('click', () => {
                    settings.apiKeys.splice(Number(button.dataset.keyRemove), 1);
                    persist();
                    renderApiKeys();
                })
            );
    }
    $('#add-api-key').addEventListener('click', () => {
        const input = $('#new-api-key') as HTMLInputElement,
            key = input.value.trim();
        if (!key || settings.apiKeys.includes(key)) return;
        settings.apiKeys.push(key);
        input.value = '';
        persist();
        renderApiKeys();
    });
    function closeSettings() {
        const overlay = $('#settings-dialog');
        overlay.hidden = true;
        overlay.classList.remove('is-open');
    }
    $('#settings-close').addEventListener('click', closeSettings);
    $('#settings-dialog').addEventListener('click', (event) => {
        if (event.target === $('#settings-dialog')) closeSettings();
    });
    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !$('#settings-dialog').hidden) closeSettings();
    });
    function applyAccent() {
        document.documentElement.style.setProperty('--chat-accent', settings.accent || '#8b74dc');
    }
    applyAccent();
    $('#accent-color').addEventListener('input', () => {
        settings.accent = ($('#accent-color') as HTMLInputElement).value;
        applyAccent();
        persist();
    });
    $('#model-menu-toggle').addEventListener('click', () => {
        const menu = $('#model-menu');
        menu.hidden = !menu.hidden;
        $('#model-menu-toggle').setAttribute('aria-expanded', String(!menu.hidden));
    });
    function renderEffortMenu() {
        const options = [
            ['auto', 'Auto'],
            ['low', 'Low'],
            ['medium', 'Medium'],
            ['high', 'High']
        ];
        const value = settings.thinkingEffort || 'auto';
        $('#effort-label').textContent = options.find(([key]) => key === value)?.[1] ?? 'Auto';
        $('#effort-menu').innerHTML = options
            .map(([key, label]) => `<button type="button" class="model-option ${key === value ? 'active' : ''}" data-effort="${key}">${label}</button>`)
            .join('');
        $('#effort-menu')
            .querySelectorAll<HTMLButtonElement>('[data-effort]')
            .forEach((button) =>
                button.addEventListener('click', () => {
                    settings.thinkingEffort = button.dataset.effort;
                    persist();
                    renderEffortMenu();
                    $('#effort-menu').hidden = true;
                    $('#effort-menu-toggle').setAttribute('aria-expanded', 'false');
                })
            );
    }
    renderEffortMenu();
    $('#effort-menu-toggle').addEventListener('click', () => {
        const menu = $('#effort-menu');
        menu.hidden = !menu.hidden;
        $('#effort-menu-toggle').setAttribute('aria-expanded', String(!menu.hidden));
    });
    document.addEventListener('click', (event) => {
        const target = event.target as Element;
        if (!target.closest('.model-picker')) {
            $('#model-menu').hidden = true;
            $('#model-menu-toggle').setAttribute('aria-expanded', 'false');
        }
        if (!target.closest('.effort-picker')) {
            $('#effort-menu').hidden = true;
            $('#effort-menu-toggle').setAttribute('aria-expanded', 'false');
        }
        if (!target.closest('.chat-actions-wrap') && !target.closest('#active-chat-menu')) {
            $('#active-chat-menu').hidden = true;
            $('#chat-actions').setAttribute('aria-expanded', 'false');
        }
    });
    $('#refresh-models').addEventListener('click', async () => {
        const status = $('#settings-status');
        if (!settings.apiKeys.length) {
            status.textContent = 'Add and save an API key first.';
            return;
        }
        status.textContent = 'Fetching Gemini models from Google…';
        let lastError = 'No response';
        for (const key of settings.apiKeys) {
            try {
                let token = '',
                    found: Model[] = [];
                do {
                    const url = new URL('https://generativelanguage.googleapis.com/v1beta/models');
                    url.searchParams.set('pageSize', '1000');
                    if (token) url.searchParams.set('pageToken', token);
                    const response = await fetch(url, { headers: { 'x-goog-api-key': key } });
                    const body = await response.json();
                    if (!response.ok) throw new Error(body.error?.message || `Request failed (${response.status})`);
                    found = found.concat(
                        (body.models ?? []).filter(
                            (model: Model) => modelName(model.name).startsWith('gemini-') && model.supportedGenerationMethods?.includes('generateContent')
                        )
                    );
                    token = body.nextPageToken ?? '';
                } while (token);
                availableModels = found;
                localStorage.setItem(MODELS_KEY, JSON.stringify(availableModels));
                const known = new Set(availableModels.map((model) => modelName(model.name)));
                settings.enabledModels = (settings.enabledModels ?? []).filter((name) => known.has(name));
                if (!settings.enabledModels.length) settings.enabledModels = availableModels.map((model) => modelName(model.name));
                renderModelSettings();
                renderModelMenu();
                persist();
                status.textContent = `Loaded ${availableModels.length} Gemini models.`;
                return;
            } catch (error) {
                lastError = error instanceof Error ? error.message : 'Request failed';
            }
        }
        status.textContent = `Could not fetch models: ${lastError}`;
    });
    renderModelMenu();
    renderModelSettings();
    $('#mobile-menu').addEventListener('click', () => $('#chat-sidebar').classList.add('open'));
    $('#sidebar-toggle').addEventListener('click', () => $('#chat-sidebar').classList.remove('open'));
    $('#chat-actions').addEventListener('click', () => {
        const menu = $('#active-chat-menu'),
            chat = current();
        if (!menu.hidden && menu.dataset.chatId === chat?.id) {
            menu.hidden = true;
            $('#chat-actions').setAttribute('aria-expanded', 'false');
            return;
        }
        if (chat) showChatMenu(chat.id, $('#chat-actions'));
    });
    $('#active-chat-menu').addEventListener('click', (event) => {
        const chatId = $('#active-chat-menu').dataset.chatId,
            chat = chats.find((item) => item.id === chatId),
            action = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-action]')?.dataset.action;
        if (!chat || !action) return;
        if (action === 'rename') {
            const name = prompt('Rename chat', chat.title)?.trim();
            if (name) chat.title = name;
        }
        if (action === 'pin') chat.pinned = !chat.pinned;
        if (action === 'delete') {
            if (confirm(`Delete “${chat.title}”?`)) deleteChat(chat.id);
        }
        persist();
        renderMessages();
        $('#active-chat-menu').hidden = true;
    });
    function renderAttachmentList() {
        const list = $('#attachment-list');
        list.replaceChildren();
        pendingFiles.forEach((file, index) => {
            const chip = document.createElement('span');
            chip.className = 'attachment-chip';
            chip.textContent = file.name;
            const remove = document.createElement('button');
            remove.type = 'button';
            remove.textContent = '×';
            remove.setAttribute('aria-label', `Remove ${file.name}`);
            remove.addEventListener('click', () => { pendingFiles.splice(index, 1); renderAttachmentList(); });
            chip.append(remove);
            list.append(chip);
        });
        list.hidden = pendingFiles.length === 0;
    }
    $('#attach').addEventListener('click', () => ($('#file-input') as HTMLInputElement).click());
    $('#file-input').addEventListener('change', (event) => {
        const input = event.currentTarget as HTMLInputElement;
        const files = [...(input.files ?? [])];
        if (pendingFiles.length + files.length > 10) toast('Attach up to 10 files per message.');
        pendingFiles = [...pendingFiles, ...files].slice(0, 10);
        input.value = '';
        renderAttachmentList();
    });
    renderSidebar();
    renderMessages();
</script>

