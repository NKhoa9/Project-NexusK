---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Calculonton">
    <div class="mx-auto max-w-md rounded-2xl border border-white/10 bg-black/40 p-8 shadow-2xl">
        <h1 class="mb-6 text-center text-3xl sm:text-4xl">Calculonton</h1>
        <form id="calc-form" class="flex flex-col gap-4">
            <label class="flex flex-col gap-2 text-sm text-white/70">
                Type expression
                <input name="expression" type="text" inputmode="decimal" autocomplete="off" placeholder="e.g. 2 + 2" required class="text-lg" />
            </label>
            <button class="btn" type="submit">Calculate</button>
        </form>
        <div id="calc-result" class="flex min-h-24 items-center justify-center text-center" role="status" aria-live="polite"></div>
    </div>
</Layout>

<script>
    const PROCESSING_MS = 5000;
    const form = document.getElementById('calc-form') as HTMLFormElement | null;
    const result = document.getElementById('calc-result');

    form?.addEventListener('submit', (e) => {
        // Handle via submit (so Enter works) and prevent the default full-page reload.
        e.preventDefault();
        if (!result) return;
        form.hidden = true;
        result.innerHTML = '<span class="animate-pulse text-white/70">Processing…</span>';

        setTimeout(() => {
            result.innerHTML = '<p class="text-4xl font-bold">Hello World! lol</p>';
        }, PROCESSING_MS);
    });
</script>
