---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found">
    <div class="flex flex-col items-center py-16 text-center">
        <p class="text-7xl font-bold text-primary">404</p>
        <h1 class="mt-4 text-3xl sm:text-4xl">This page wandered off.</h1>
        <p class="mt-3 text-white/60">It doesn’t exist, or it hasn’t been built yet.</p>
        <a href="/" class="btn btn-lg mt-8">Back to home</a>
    </div>
</Layout>
