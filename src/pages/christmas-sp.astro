---
import Layout from '../layouts/Layout.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
---

<Layout title="Merry Christmas!">
    <h1 class="mb-8 text-center">Merry Christmas! 🎄</h1>
    <VideoEmbed videoId="GxCb0pgO9Ig" title="Christmas special" autoplay controls={false} />

    <!-- Background music: kept off-screen rather than as a tiny visible box. -->
    <iframe
        class="pointer-events-none fixed -left-[9999px] h-px w-px opacity-0"
        src="https://www.youtube.com/embed/qrm8w-pV120?controls=0&autoplay=1&loop=1&playlist=qrm8w-pV120"
        title="Background music"
        allow="autoplay; encrypted-media"
        tabindex="-1"
        aria-hidden="true"></iframe>

    <p class="mt-6 text-center text-white/70">
        BGM link <a href="https://youtu.be/qrm8w-pV120" target="_blank" rel="noopener noreferrer">here</a> lol
    </p>
</Layout>
