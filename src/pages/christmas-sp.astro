---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Merry Christmas!">
    <div class="relative aspect-16/9">
        <div class="h-0 pt-[30%]">
            <iframe
                class="h-full w-full absolute top-0 left-0"
                src="https://www.youtube.com/embed/GxCb0pgO9Ig?si=yBZR1dx4SNAykmSH&controls=0&autoplay=1"
                title="YouTube video player"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen></iframe>
        </div>
        <iframe
            width="10"
            height="10"
            src="https://www.youtube.com/embed/qrm8w-pV120?si=GFb7qxv_T7L_js9p&controls=0&autoplay=1&loop=1&playlist=qrm8w-pV120"
            title="YouTube video player"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen></iframe>
    </div>
    <p>BGM link <a href="https://youtu.be/qrm8w-pV120?si=TYuICKRdu5xP-C86"> here</a> lol</p>
</Layout>
