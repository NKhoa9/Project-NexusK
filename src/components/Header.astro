---
import Logo from '../components/Logo.astro';

const navItems = [
    { linkText: 'Project NexusK', href: '/' },
    { linkText: 'RR embed', href: '/rrembed' },
    //{ linkText: 'Revalidation', href: '/revalidation' },
    { linkText: 'Corgi!', href: '/image-cdn' }
    //{ linkText: 'Edge Function', href: '/edge' },
    //{ linkText: 'Blobs', href: '/blobs' }*/
];
---

<nav
    class="flex flex-wrap items-center gap-4 sm:pt-1 sm:pb-1 text-2xl font-bold box-border border-10 border-transparent"
    style="background-color: rgba(0, 0, 0, 0.212);"
>
    <a href="/">
        <Logo />
    </a>
    {
        !!navItems?.length && (
            <ul class="flex flex-wrap gap-x-2 gap-y-1">
                {navItems.map((item) => (
                    <li>
                        <a href={item.href} class="inline-block px-1.5 py-1 sm:px-3 sm:py-2 no-underline">
                            {item.linkText}
                        </a>
                    </li>
                ))}
            </ul>
        )
    }
</nav>
