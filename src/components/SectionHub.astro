---
import Layout from '../layouts/Layout.astro';
import { getSection } from '../data/navigation';

interface Props {
    section: string;
}

const { title, description, items } = getSection(Astro.props.section);
---

<Layout title={title} description={description}>
    <header class="mb-10 text-center">
        <h1>{title}</h1>
        <p class="mt-3 text-white/60">{description}</p>
    </header>
    {
        items.length ? (
            <ul class="grid gap-4 sm:grid-cols-2">
                {items.map((item) => (
                    <li>
                        <a href={item.href} class="card h-full">
                            <span class="flex items-center justify-between text-xl font-semibold">
                                {item.label}
                                <span class="text-primary" aria-hidden="true">
                                    →
                                </span>
                            </span>
                            {item.description && <span class="mt-2 block text-sm text-white/60">{item.description}</span>}
                        </a>
                    </li>
                ))}
            </ul>
        ) : (
            <p class="rounded-xl border border-dashed border-white/20 p-10 text-center text-white/60">Nothing here yet lol — check back later!</p>
        )
    }
</Layout>
