---
import '../styles/globals.css';
import '@fontsource-variable/inter/wght.css';
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
    title: string;
    description?: string;
    /** Render the page content edge-to-edge instead of inside the centered content container. */
    fullWidth?: boolean;
}

const { title, description = 'Project NexusK — a small corner of the internet by team SAKUL.', fullWidth = false } = Astro.props;
const pageTitle = title === 'Project NexusK' ? title : `${title} | Project NexusK`;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{pageTitle}</title>
        <meta name="description" content={description} />
        <meta name="theme-color" content="#000000" />
        <meta name="generator" content={Astro.generator} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="preload" as="font" type="font/woff2" href={interWoff2} crossorigin />
    </head>
    <body class="bg-complementary text-white antialiased">
        <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-primary-content">
            Skip to content
        </a>
        <div class="flex min-h-screen flex-col bg-noise pt-[4.25rem]">
            <Header />
            <main id="main" class:list={['grow py-10 sm:py-14', !fullWidth && 'container-page']}>
                <slot />
            </main>
            <Footer />
        </div>
    </body>
</html>
